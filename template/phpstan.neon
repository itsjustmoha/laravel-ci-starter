includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    # Existing project with lots of errors? Generate a baseline once:
    #   vendor/bin/phpstan analyse --generate-baseline
    # then uncomment the next line and commit phpstan-baseline.neon.
    # - phpstan-baseline.neon

parameters:
    # 0 is the loosest, 10 the strictest. 9 is strict without being noisy.
    level: 9

    paths:
        - app/
        - config/
        - database/
        - routes/
